# Example Grafana ClickHouse datasource for ClickStack.
# Copy to datasources.yaml (or merge) and fill host/auth from your environment.
# Never commit real passwords — use env substitution or Grafana secrets.

apiVersion: 1

datasources:
  - name: ClickHouse
    type: grafana-clickhouse-datasource
    uid: clickhouse
    access: proxy
    jsonData:
      host: clickhouse
      port: 9000
      protocol: native
      defaultDatabase: default
      username: default
      # tlsSkipVerify: false
      # Required for Grafana Explore Traces/Logs builders (and APM deep links
      # that open Explore). Without these, the CH plugin emits empty-table SQL.
      traces:
        defaultDatabase: default
        defaultTable: otel_traces
        otelEnabled: true
        otelVersion: latest
        durationUnit: nanoseconds
      logs:
        defaultDatabase: default
        defaultTable: otel_logs
        otelEnabled: true
        otelVersion: latest
    secureJsonData:
      password: ${CLICKHOUSE_PASSWORD}
