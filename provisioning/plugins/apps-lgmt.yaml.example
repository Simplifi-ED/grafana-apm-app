# Optional LGTM dual-mode plugin config — use with cloud-lgmt.yaml.example datasources.

apiVersion: 1

apps:
  - type: 'omnivya-apm-app'
    org_id: 1
    disabled: false
    jsonData:
    # Optional: map data env → notification-policy env label
    # alertRoutingEnvironments:
    #   prod: prod-gcp
      metricsDataSource:
        uid: mimir
        type: prometheus
      tracesDataSource:
        uid: tempo-prod
        type: tempo
      logsDataSource:
        uid: loki
        type: loki
